{
  "name": "parse-excel",
  "label": "Parse Excel File",
  "description": "Upload a binary Excel file (.xlsx/.xls) and return each row as a bundle",
  "type": "search",
  "connection": "api-key",
  "communication": {
    "url": "/api/v1/parse-excel",
    "method": "post",
    "type": "multipart/form-data",
    "qs": {
      "sheet": "{{parameters.sheet}}",
      "header_row": "{{parameters.header_row}}"
    },
    "body": {
      "file": {
        "value": "{{parameters.file_data}}",
        "options": {
          "filename": "{{parameters.file_name}}"
        }
      }
    },
    "response": {
      "iterate": "{{body.bundles}}",
      "output": "{{item}}",
      "limit": "{{parameters.limit}}"
    }
  },
  "staticParameters": [],
  "parameters": [
    {
      "name": "file_name",
      "type": "text",
      "label": "File name",
      "required": true,
      "semantic": "file:name"
    },
    {
      "name": "file_data",
      "type": "buffer",
      "label": "File data",
      "required": true,
      "semantic": "file:data"
    },
    {
      "name": "sheet",
      "type": "text",
      "label": "Sheet",
      "help": "Name or 0-based index of the sheet. Leave empty to use the first sheet."
    },
    {
      "name": "header_row",
      "type": "uinteger",
      "label": "Header row",
      "help": "0-based index of the row used as header.",
      "default": 0
    },
    {
      "name": "limit",
      "type": "uinteger",
      "label": "Limit",
      "help": "Maximum number of rows (bundles) to return per execution cycle.",
      "default": 100
    }
  ],
  "interface": [
    "rpc://get-columns"
  ],
  "samples": {
    "Nombre": "Ana",
    "Edad": "30",
    "Ciudad": "Madrid"
  }
}
